{
	// frontier-sync: encrypted settings sync for Frontier Wallet.
	// Deployed to the Delfos Hub Cloudflare account:
	//   source ~/.delfos-cf.env && npx wrangler deploy
	"name": "frontier-sync",
	"main": "worker.js",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	// no id on purpose: wrangler (4.45+) creates the namespace on the first
	// deploy and keeps it linked on later ones
	"kv_namespaces": [
		{
			"binding": "SYNC",
			"id": "cfe11b00ddb842dc9e5d1165a0a14588"
		}
	],
	// per client (IPv4, or IPv6 /64): writes spend the account's KV write
	// quota, shared with relayer-watchdog. The namespace ids must differ
	// from the other Workers' on the account (offers-worker uses its own).
	"ratelimits": [
		{ "name": "WRITES", "namespace_id": "2611", "simple": { "limit": 10, "period": 60 } },
		{ "name": "READS", "namespace_id": "2612", "simple": { "limit": 60, "period": 60 } }
	]
}
