# Cloudflare Pages response headers.
# The policy repeats the <meta> one in index.html and adds what a <meta>
# cannot set: which pages may frame the wallet. Telegram's web client frames
# Mini Apps, so its origins stay allowed.
/*
  Content-Security-Policy: script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
